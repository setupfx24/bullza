//@version=5
// ============================================================================
//  SwisDex AI Station — EMA Crossover (max 2 trades/day)
//  Sends alerts to your platform's TradingView webhook. On a fill it opens the
//  trade WITH SL/TP; on SL/TP hit it sends a close for the SAME trade id.
//
//  Alert JSON matches the AI Station webhook contract:
//    open : {"action":"buy"|"sell","symbol":"XAUUSD","sl":<p>,"tp":<p>,"id":"<uniq>"}
//    close: {"action":"close","id":"<same uniq>"}
//
//  SETUP (once):
//   1. Paste this in TradingView → Pine Editor → Add to chart.
//   2. Create alert → Condition = this strategy → "Order fills only".
//      Message box:  {{strategy.order.alert_message}}
//      Notifications tab → Webhook URL = (from Admin → AI Station → Connection)
//        e.g.  https://api.swisdex.com/api/v1/webhooks/tradingview/<secret>
//   3. In Admin → AI Station → Connection: Enabled = ON, slabs saved.
//  Make sure the chart symbol maps to a platform instrument (see "Platform
//  symbol" input — leave blank to use the chart's ticker, e.g. XAUUSD).
// ============================================================================
strategy("SwisDex AI Station — EMA Cross (Daily 2)",
     overlay          = true,
     calc_on_every_tick = false,
     pyramiding       = 0,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100)

// ── Inputs ──────────────────────────────────────────────────────────────────
fastLen  = input.int(9,  "Fast EMA length", minval = 1)
slowLen  = input.int(21, "Slow EMA length", minval = 2)
slPoints = input.float(5.0,  "Stop loss (price distance)",   minval = 0.0, step = 0.1)
tpPoints = input.float(10.0, "Take profit (price distance)", minval = 0.0, step = 0.1)
maxTrades = input.int(2,  "Max trades per day", minval = 1)
symIn    = input.string("", "Platform symbol (blank = chart ticker)",
     tooltip = "Must match the instrument symbol on your platform, e.g. XAUUSD, EURUSD.")

sym = symIn == "" ? syminfo.ticker : symIn

// ── Indicators ──────────────────────────────────────────────────────────────
fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)

// ── Daily trade counter (resets each new day, exchange time) ────────────────
var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0

longSig  = ta.crossover(fast, slow)
shortSig = ta.crossunder(fast, slow)
canTrade = tradesToday < maxTrades and strategy.position_size == 0

// Unique id per trade (bar time) — reused for that trade's close.
tid = sym + "-" + str.tostring(time)

// ── Long ────────────────────────────────────────────────────────────────────
if canTrade and longSig
    slPrice = close - slPoints
    tpPrice = close + tpPoints
    openMsg = '{"action":"buy","symbol":"' + sym + '","sl":' + str.tostring(slPrice, format.mintick) + ',"tp":' + str.tostring(tpPrice, format.mintick) + ',"id":"' + tid + '"}'
    closeMsg = '{"action":"close","id":"' + tid + '"}'
    strategy.entry("L", strategy.long, alert_message = openMsg)
    strategy.exit("L-exit", from_entry = "L", stop = slPrice, limit = tpPrice, alert_message = closeMsg)
    tradesToday := tradesToday + 1

// ── Short ───────────────────────────────────────────────────────────────────
if canTrade and shortSig
    slPrice = close + slPoints
    tpPrice = close - tpPoints
    openMsg = '{"action":"sell","symbol":"' + sym + '","sl":' + str.tostring(slPrice, format.mintick) + ',"tp":' + str.tostring(tpPrice, format.mintick) + ',"id":"' + tid + '"}'
    closeMsg = '{"action":"close","id":"' + tid + '"}'
    strategy.entry("S", strategy.short, alert_message = openMsg)
    strategy.exit("S-exit", from_entry = "S", stop = slPrice, limit = tpPrice, alert_message = closeMsg)
    tradesToday := tradesToday + 1

// ── Plots ───────────────────────────────────────────────────────────────────
plot(fast, "Fast EMA", color = color.new(color.green, 0), linewidth = 2)
plot(slow, "Slow EMA", color = color.new(color.red,   0), linewidth = 2)
plotchar(longSig  and canTrade, "Buy",  "▲", location.belowbar, color.new(color.green, 0), size = size.tiny)
plotchar(shortSig and canTrade, "Sell", "▼", location.abovebar, color.new(color.red,   0), size = size.tiny)
